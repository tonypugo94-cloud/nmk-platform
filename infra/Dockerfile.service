# Общий образ для всех Node-сервисов: SERVICE — папка в services/.
FROM node:22-alpine
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
COPY services ./services
RUN pnpm install --frozen-lockfile --prod=false
ARG SERVICE
ENV SERVICE=${SERVICE} NODE_ENV=production
USER node
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://localhost:8080/health || exit 1
CMD ["sh", "-c", "npx tsx services/${SERVICE}/src/main.ts"]
