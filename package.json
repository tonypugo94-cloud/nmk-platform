{
  "name": "nmk-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:reset": "tsx packages/db/src/migrate.ts --reset",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "zod": "^3.24.1",
    "@nmk/shared": "workspace:*",
    "@nmk/accounting": "workspace:*",
    "@nmk/db": "workspace:*",
    "@nmk/bots": "workspace:*"
  }
}